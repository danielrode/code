#!/usr/bin/env python3
# author: daniel rode
# dependencies: podman, hunspell
# updated: -


import os
import sys
import subprocess as sp
from pathlib import Path
from tempfile import TemporaryDirectory


# Functions
def cd0() -> None:
    """Set working directory to the same location as the running script."""

    os.chdir(Path(__file__).resolve().parent)

def print2(*a, **kw):
    print(*a, **kw, file=sys.stderr)

def podman(con_args, img, entry_args, sp_args):
    cmd = (
        "podman",
        "run",
        "--rm",
        "--interactive",
        "--volume=./:/portal",
        "--workdir=/portal",
        *con_args,
        img,
        *entry_args,
    )
    return sp.run(cmd, text=True, **sp_args)

def typst(
    *args,
    podman_args=[],
    sp_args={'capture_output': True},
) -> str:
    p = podman(
        con_args=(
            "--entrypoint=typst",
            *podman_args,
        ),
        img="docker.io/pandoc/typst:latest",
        entry_args=args,
        sp_args=sp_args,
    )

    if p.stderr:
        print2(p.stderr)
    if p.returncode != 0:
        print2("error: Typst:", p)

    return p.stdout

def pandoc(
    *args,
    podman_args=[],
    sp_args={'check': True},
) -> None:
    podman(
        con_args=podman_args,
        img="docker.io/pandoc/typst:latest",
        entry_args=args,
        sp_args=sp_args,
    )


# Set working directory
cd0()

# Spell check
cmd = """
    cat ./presentation.typ \
    | podman run --rm --interactive docker.io/pandoc/typst:latest \
         --from typst --to plain \
    | hunspell -l \
    | sort \
    | uniq \
"""
sp.run(cmd, check=True, shell=True)

# Compile to PDF
typst(
    "compile",
    "./presentation.typ",
    "./export.pdf",
)

# Exit if only PDF is desired
if Path(__file__).stem == 'preview':
    sys.exit(0)

# Compile to PPTX (PowerPoint) and revealjs (HTML)
with TemporaryDirectory() as tmpdir:
    tmpdir = Path(tmpdir)

    # Compile to PNGs
    typst(
        "compile",
        "--ppi", "300",
        "./presentation.typ",
        str(tmpdir / "img{0p}.png"),
        podman_args=[f'-v={tmpdir}:{tmpdir}'],
    )

    # Compile to PPTX
    md_blob = "\n".join([
        # https://pandoc.org/demo/example33/10.8-background-in-reveal.js-beamer-and-pptx.html
        # https://revealjs.com/backgrounds/
        # https://revealjs.com/transitions/
        f"""# {{
            data-background-image="{i}"
            data-background-size="contain"
            data-background-position="center"
            data-background-repeat="no-repeat"
            data-background-opacity="1"
            data-background-color="black"
            data-transition="none"
            data-background-transition="none"
        }}"""
        for i in sorted(list(tmpdir.glob("*.png")))
    ])
    pandoc(
        "--from=markdown",
        "--to=pptx",
        "--output=./export.pptx",
        "-",  # Read from stdin
        podman_args=[f"-v={tmpdir}:{tmpdir}"],
        sp_args={"input": md_blob}
    )

    # Compile to revealjs (HTML)
    pandoc(
        "--standalone",
        "--embed-resources",
        "--from=markdown",
        "--to=revealjs",
        "--output=./export.html",
        "-",  # Read from stdin
        podman_args=[f"-v={tmpdir}:{tmpdir}"],
        sp_args={"input": md_blob}
    )


