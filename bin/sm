#!/usr/bin/env python3
# author: daniel rode
# dependencies: sshfs, ~/.nunyuh
# created: 25 jul 2024
# updated: 09 jul 2026


"""Alias/shortcuts for mounting remote directories via SSH."""


import sys
import tomllib
import subprocess as sp
from pathlib import Path


# Constants
HOME = Path.home()

NY = tomllib.loads(Path(HOME / '.nunyuh').read_text())['sm']

SSHFS_VER = next(filter(lambda x: x.startswith('SSHFS version '), sp.run(
    ('sshfs', '--version'), check=True, text=True, capture_output=True,
).stdout.splitlines())).split(' ')[-1]

SSHFS_OPTS = (
    '-o', 'delay_connect',
    '-o', 'reconnect',
    '-o', 'noatime',
    # '-o', 'umask=177',

    # Give up trying to connect if it takes too long
    '-o', 'ConnectionAttempts=3',
    '-o', 'ConnectTimeout=10',

    # Disconnect if server disappears for too long
    '-o', 'ServerAliveCountMax=4',
    '-o', 'ServerAliveInterval=11',

    # Gymnastics to prevent remote symlinks from appearing to dangle
    '-o', 'transform_symlinks',
)
if SSHFS_VER != '3.7.5':
    SSHFS_OPTS = (*SSHFS_OPTS, '-o', 'no_contain_symlinks')


# Functions
def sshfs(
    mnt_point: Path,
    sshfs_args: list,
    remote_host: str,
    remote_dir: Path,
) -> None:
    mnt_point = Path(mnt_point)

    if mnt_point.is_mount():
        print("Already mounted:", mnt_point)
        return

    cmd = (
        'sshfs', *sshfs_args,
        f"{remote_host}:{remote_dir}",
        str(mnt_point),
    )
    sp.run(cmd, check=True)


# Parse command line input
try:
    remote = sys.argv[1]
except IndexError:
    print("Enter mount point")
    sys.exit(1)

# Set values for remote host
try:
    mnt_list = NY[remote]
except KeyError:
    print("error: Unknown alias:", remote)
    sys.exit(1)

del NY

# Mount
for remote_dir, mount_point in mnt_list:
    sshfs(mount_point, SSHFS_OPTS, remote, remote_dir)
