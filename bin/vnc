#!/usr/bin/env python3
# author: daniel rode
# dependencies:
#   nc
#   tigervnc
#   wayvnc
# created: 31 jul 2026
# updated: -


"""Macro for starting VNC (remote desktop) sessions over SSH to Sway."""


import sys
import time
import socket
import subprocess as sp
from pathlib import Path


EXE_NAME = Path(__file__).name  # This script's filename
HELP = f"Usage: {EXE_NAME} SSH_REMOTE"

TIGERVNC_PREAMBLE = [
    'vncviewer',
    'CompressLevel=9',
    'DesktopSize=on',
    # "Color level to use on slow connections: 0=VeryLow, 1=Low, 2=Medium"
    # 'LowColorLevel=0',
    'ReconnectOnError=on',
    'RemoteResize=on',
    # TODO maybe consider the next couple commands instead of VNC resize?
    # swaymsg output HDMI-A-1 resolution 1920x1080
    # sway-scale-output 1
]


# Parse command line arguments
try:
    remote = sys.argv[1]
except IndexError:
    print(HELP)
    sys.exit(1)

# Start VNC server on remote
remote_vnc_server_p = sp.Popen((
    'ssh',
        remote,
    'env',
        'WAYLAND_DISPLAY=wayland-1',
    'wayvnc',
        '--output', 'DP-1',
))

# Wait for VNC server to finish starting
while True:
    time.sleep(0.01)
    try:
        sp.run(('ssh', remote, 'nc', '-zv', '127.0.0.1', '5900'), check=True)
    except sp.CalledProcessError:
        continue
    break

# Forward remote VNC port to this host
ssh_bridge = sp.Popen((
    'ssh',
    '-NL', '5901:127.0.0.1:5900',
    remote,
))

# Wait for port forward to establish
while True:
    time.sleep(0.01)
    try:
        # Create a TCP socket
        with socket.create_connection(('127.0.0.1', 5901), timeout=0.01):
            break
    except (socket.timeout, ConnectionRefusedError, OSError):
        continue

# Start VNC viewer GUI
# sp.run(('remmina', '--connect', 'vnc://localhost:5901'))
try:
    sp.run((*TIGERVNC_PREAMBLE, 'localhost:5901'))
except KeyboardInterrupt:
    pass

# Cleanup (end background processes)
ssh_bridge.terminate()
remote_vnc_server_p.terminate()
