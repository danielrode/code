#!/usr/bin/env python3
# author: daniel rode
# dependencies: podman, podman-compose, crun-krun, ~/.nunyuh
# created: 12 apr 2026
# updated: 18 aug 2026


"""Setup and run containerized Joplin (notes) server."""

# NOTE:
# Joplin server's default username and pw: "admin@localhost", "admin"
# Change these first thing!


import pwd
import json
import shlex
import getpass
import tomllib
import subprocess as sp
from pathlib import Path


APP_NAME = 'joplin'

HOME = Path.home()
USER = getpass.getuser()

NY = tomllib.loads(Path(HOME, '.nunyuh').read_text())['S'][APP_NAME]

# rathole:v0.5.0 container image ID
RH_IMG_ID = "a31b9178e985d4a84f46d4c3af6aa200ee0c5e7f821c7075a1f6669fb77392b1"

CON_HARDENED_DEFAULTS = {
    'cap_drop': ['ALL'],
    'security_opt': ['no-new-privileges'],
    'read_only': True,
    'tmpfs': ['/tmp:rw,noexec,nosuid,nodev,mode=1700'],
    'deploy': {'resources': {'limits': {
        'mem_limit': '128m',  # Limit memory usage
        'cpus': 0.5,  # Limit CPU usage to 50% of a single core
    }}},
}
CON_SERVICES = {
    'rathole': CON_HARDENED_DEFAULTS | {
        'image': f'docker.io/rapiz1/rathole@sha256:{RH_IMG_ID}',
        'container_name': f'{APP_NAME}_rathole',
        'secrets': [{
            'source': APP_NAME + '_rh_conf',
            'target': '/etc/rathole.toml',
            'uid': '0',
            'gid': '0',
            'mode': '0444',
        }],
        'command': '/etc/rathole.toml',
        'restart': 'always',
        # "...the microVM ignores the USER set in the Dockerfile and always
        # boots as root. Either switch to the correct user manually or put the
        # switch into an entrypoint script."
        # https://fedoramagazine.org/sandbox-ai-coding-agents-with-microvms-on-fedora-linux/
        # TODO what about setting the user here (in compose)? does that work?
        'user': '1111:1111',
    },
    'db': CON_HARDENED_DEFAULTS | {
        'image': 'docker.io/postgres:16',
        'container_name': f'{APP_NAME}_db',
        'volumes': [
            {
                'type': 'volume',
                'source': 'postgres',
                'target': '/var/lib/postgresql/data',
                'volume': {
                    'U': True,
                    'mode': 0o700,
                },
            },
        ],
        'environment': [
            'POSTGRES_PASSWORD=' + NY['db_pw'],  # TODO make podman secret somehow?
            'POSTGRES_USER=joplin0',
            'POSTGRES_DB=joplindb',
        ],
        'restart': 'always',
        # 'deploy': { 'resources': { 'limits': {
        #     'mem_limit': '256m',
        'user': '999:999',
    },
    'joplin': CON_HARDENED_DEFAULTS | {
        'image': 'docker.io/joplin/server:latest',
        'container_name': f'{APP_NAME}_server',
        'depends_on': ['db'],
        'tmpfs': [
            '/tmp:rw,noexec,nosuid,nodev,mode=1777',
            '/opt/pm2:rw,noexec,nosuid,nodev,mode=1777',
            '/home/joplin/packages:rw,nosuid,nodev,mode=1700',
        ],
        'environment': [
            'APP_PORT=22300',
            'APP_BASE_URL=' + NY['origin'],
            'DB_CLIENT=pg',
            'POSTGRES_PASSWORD=' + NY['db_pw'],  # TODO make podman secret somehow?
            'POSTGRES_DATABASE=joplindb',
            'POSTGRES_USER=joplin0',
            'POSTGRES_PORT=5432',
            'POSTGRES_HOST=db',
        ],
        'restart': 'always',
        # 'deploy': { 'resources': { 'limits': {
        #     'mem_limit': '256m',
    },
}
CON_COMPOSE = {
    'version': '3',
    'name': APP_NAME,
    'services': CON_SERVICES,
    'volumes': {
        'postgres': {},
    },
    'secrets': {
        APP_NAME + '_rh_conf': {'external': True},
    },
}

CON_IMG_TAG = "app_" + APP_NAME
DOCKERFILE = f"""
FROM quay.io/podman/stable:latest
COPY <<'EOF' /etc/joplin_compose.yaml
{json.dumps(CON_COMPOSE)}
EOF
RUN <<'EOF'
set -e
set -x
dnf install -y --refresh --setopt=install_weak_deps=False \
    podman-compose \
;
dnf clean all
EOF
"""

RH_CONF = f"""
[client]
remote_addr = "{NY['rh_addr']}"
[client.services.joplin]
type = "tcp"
token = "{NY['rh_token']}"
local_addr = "joplin:22300" 
"""

SETUP_ROOT_SH_PAYLOAD = f"""
set -e
set -x

# Add user for service
id app_{shlex.quote(APP_NAME)} &>/dev/null || \\
    useradd -m app_{shlex.quote(APP_NAME)}
usermod -a -G app_{shlex.quote(APP_NAME)} {shlex.quote(USER)}
loginctl enable-linger app_{shlex.quote(APP_NAME)}
# systemctl daemon-reload

# Install systemd service file
umask 0022
tee <<'EOF' > /etc/systemd/user/app_{shlex.quote(APP_NAME)}.service
[Unit]
Description=app_{APP_NAME}
Requires=dbus.socket
After=dbus.socket
After=network-online.target
[Service]
Type=forking
Restart=on-failure
RestartSec=33
ExecStart=/usr/bin/podman pod start pod_{APP_NAME}
ExecStop=/usr/bin/podman pod stop pod_{APP_NAME}
[Install]
WantedBy=default.target
EOF

# Allow current user to login as service user
tee <<'EOF' > /etc/sudoers.d/app_{shlex.quote(APP_NAME)}
{USER} ALL=(app_{APP_NAME}) NOPASSWD: ALL
EOF
sudo chmod 440 /etc/sudoers.d/app_{shlex.quote(APP_NAME)}
"""


# Run setup code that needs to be run as root
try:
    app_user_id = pwd.getpwnam(f'app_{APP_NAME}').pw_uid
except KeyError:
    app_user_id = None

if any((
    app_user_id is None,
    not Path(f'/etc/systemd/user/app_{APP_NAME}.service').exists(),
)):
    sp.run(
        ('sudo', 'bash'),
        check=True, text=True, input=SETUP_ROOT_SH_PAYLOAD,
    )

# Build container
app_user_id = pwd.getpwnam(f'app_{APP_NAME}').pw_uid
sudo_preamble = (
    'sudo',
        '-u', f'app_{APP_NAME}',
    'env',
        '--chdir=/tmp',
        f'XDG_RUNTIME_DIR=/run/user/{app_user_id}',
        f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{app_user_id}/bus',
)
sp.run(
    (
        *sudo_preamble,
        'podman', 'build',
            '--file=-',
            '--tag', CON_IMG_TAG,
    ),
    input=DOCKERFILE,
    check=True, text=True,
)

# Create container
sp.run(
    (
        *sudo_preamble,
        'podman', 'secret', 'create', '--replace', f'{APP_NAME}_rh_conf', '-',
    ),
    input=RH_CONF,
    check=True, text=True,
)
# sp.run(
#     (
#         *sudo_preamble,
#         'podman', 'secret', 'create', '--replace', f'{APP_NAME}_compose', '-',
#     ),
#     input=json.dumps(CON_COMPOSE),
#     check=True, text=True,
# )
sp.run(
    (
        *sudo_preamble,
        'podman',
            '--runtime=/usr/bin/krun',
            'run',
            '--name', APP_NAME,
            '--replace',
            # '--memory=8g',
            # '--cap-drop=ALL',
            '--security-opt=no-new-privileges',
            '--security-opt=proc-opts=hidepid=2',
            '--restart=unless-stopped',
            '--secret', ','.join((
                f'source={APP_NAME}_rh_conf',
                'target=/etc/rathole.toml',
                'uid=0',
                'gid=0',
                'mode=0444',
            )),
            # '--secret', ','.join((
            #     f'source={APP_NAME}_compose',
            #     'target=/etc/joplin_compose.yaml',
            #     'uid=0',
            #     'gid=0',
            #     'mode=0444',
            # )),
            CON_IMG_TAG,
        'bash', '-c', f'''
            set -e
            set -x
            mount -t tmpfs -o rw,noexec,nosuid,nodev,mode=1700 tmpfs /tmp
            # mkdir -p /dev/mqueue
            # mount -t mqueue none /dev/mqueue
            # mount -t tmpfs -o nosuid,size=90%,mode=0700 tmpfs /app
            # chown app:app /app
            # cd /app
            podman secret create {shlex.quote(APP_NAME)}_rh_conf \
                /etc/rathole.toml \
            ;
            podman-compose \
                --file=/etc/joplin_compose.yaml \
                up \
                --no-start \
            ;
            podman pod start pod_joplin
            podman pod logs --names --timestamps --follow pod_joplin
        ''',
    ),
    check=True,
)

# sp.run(
#     (
