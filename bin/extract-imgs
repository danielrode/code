#!/usr/bin/env python3
# author: daniel rode
# dependencies: poppler-utils
# created: 07 sep 2026
# updated: 08 sep 2026


"""Extract images from various file formats."""


import sys
import subprocess as sp
from pathlib import Path


def print2(*a, **kw):
	print(*a, **kw, file=sys.stderr)


src_fp = Path(sys.argv[1])


match src_fp.suffix:
    case '.pdf':
        cmd = (
            'pdfimages',
            '-print-filenames',
            '-png',
            str(src_fp),
            src_fp.stem,
        )
    case _:
    	print2("error: Unsupported file format")
    	sys.exit(1)

sp.run(cmd, check=True)


