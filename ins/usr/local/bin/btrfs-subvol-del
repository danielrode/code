# Run BTRFS subvolume delete command.


import os
import sys
import subprocess as sp
from pathlib import Path


def main():
    real_uid = os.getuid()
    for i in sys.argv[1:]:
        fp_uid = Path(i).stat().st_uid
        if real_uid != fp_uid:
            print("error: Permission denied:", i)
            sys.exit(1)

    p = sp.run(('btrfs', 'subvolume', 'delete', *sys.argv[1:]))
    sys.exit(p.returncode)

if __name__ == '__main__':
    main()
