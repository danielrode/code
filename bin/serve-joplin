#!/usr/bin/env python3
# author: daniel rode
# dependencies: podman, crun-krun, ~/.nunyuh
# created: 12 apr 2026
# updated: 22 nov 2026


"""Setup and run containerized Joplin (notes) server."""

# NOTE:
# Joplin server's default username and pw: "admin@localhost", "admin"
# Change these first thing!


import re
import pwd
import json
import shlex
import getpass
import tomllib
import subprocess as sp
from pathlib import Path


APP_NAME = 'joplin'

HOME = Path.home()
USER = getpass.getuser()
NY = tomllib.loads(Path(HOME, '.nunyuh').read_text())['S'][APP_NAME]

CHILD_IMG_CACHE_DIR = Path(f"/home/app_{APP_NAME}/docker_imgs/")

HARDENED_TMPFS = 'rw,noexec,nosuid,nodev,mode=1700'
CON_DEFAULTS = (
    '--pod=app',
    # '--tz=local',
    '--restart=always',

    # Hardening
    '--cpus=0.5',  # Limit CPU usage to 50% of a single core
    '--memory=128m',
    '--security-opt=no-new-privileges',
    '--security-opt=proc-opts=hidepid=2',
    '--cap-drop=ALL',
    # '--user=1111:1111',
    '--read-only',
    '--read-only-tmpfs',
    # '--tmpfs=/tmp:' + HARDENED_TMPFS,
)
CON_SERVICES = {
    'docker.io/rapiz1/rathole:v0.5.0': (
        *CON_DEFAULTS,
        # '--user=1000:1000',
        '--tmpfs=/tmp:' + HARDENED_TMPFS,
        '--name=RATHOLE',
        '--secret=rh_conf,type=mount,target=/etc/rathole.toml',
        '--entrypoint=' + json.dumps((
            '/app/rathole',
            '/etc/rathole.toml',
        )),
    ),
    'docker.io/postgres:16': (
        *CON_DEFAULTS,
        '--tmpfs=/tmp:' + HARDENED_TMPFS,
        '--name=DATABASE',
        '--volume=/notes_db:/var/lib/postgresql/data:U,Z,nodev,noexec,nosuid',
        '--env=POSTGRES_USER=joplin0',
        '--env=POSTGRES_DB=joplindb',
        '--secret=db_pw,type=env,target=POSTGRES_PASSWORD',
        '--user=999:999',
    ),
    'docker.io/joplin/server:latest': (
        *CON_DEFAULTS,
        '--name=JOPLIN',
        '--requires=DATABASE',
        # '--user=joplin',
        '--read-only=false',
        '--cpus=1.0',
        '--memory=512m',
        '--env=APP_PORT=22300',
        '--env=DB_CLIENT=pg',
        '--env=POSTGRES_DATABASE=joplindb',
        '--env=POSTGRES_USER=joplin0',
        '--env=POSTGRES_PORT=5432',
        '--env=POSTGRES_HOST=::1',
        '--secret=db_pw,type=env,target=POSTGRES_PASSWORD',
        '--secret=origin,type=env,target=APP_BASE_URL',
    ),
}

VM_CONTAINER = (
    'podman',
    '--runtime=/usr/bin/krun',
    'run',
    '--name=app_' + APP_NAME,
    '--replace',
    '--pull=newer',
    '--memory=1g',
    # '--cap-drop=ALL',
    '--security-opt=no-new-privileges',
    '--security-opt=proc-opts=hidepid=2',
    '--restart=always',
    '--secret=app_rh_conf,type=mount,target=/etc/rathole.toml',
    '--secret=app_origin,type=mount,target=/pod_secret__origin',
    '--secret=app_db_pw,type=mount,target=/pod_secret__db_pw',
    '--volume={}:/docker_imgs:ro,Z'.format(CHILD_IMG_CACHE_DIR),
    '--volume=notes_db:/notes_db',
    'quay.io/podman/stable:latest',
)

RH_CONF = f"""
[client]
remote_addr = "{NY['rh_addr']}"
[client.services.joplin]
type = "tcp"
token = "{NY['rh_token']}"
local_addr = "localhost:22300"
"""

INIT_CON_SH_FP = Path(f"/home/app_{APP_NAME}/start-{APP_NAME}.sh")

SETUP_ROOT_SH_PAYLOAD = f"""
set -e
set -x

# Add user for service
id app_{shlex.quote(APP_NAME)} &>/dev/null || \\
    useradd -m app_{shlex.quote(APP_NAME)}
usermod -a -G app_{shlex.quote(APP_NAME)} {shlex.quote(USER)}
chmod 770 /home/app_{shlex.quote(APP_NAME)}
loginctl enable-linger app_{shlex.quote(APP_NAME)}
systemctl daemon-reload

# Install systemd service file
umask 0022
tee <<'EOF' > /etc/systemd/user/app_{shlex.quote(APP_NAME)}.service
[Unit]
Description=app_{APP_NAME}
Requires=dbus.socket
After=dbus.socket
After=network-online.target
[Service]
Type=exec
Restart=on-failure
RestartSec=33
ExecStart={shlex.quote(str(INIT_CON_SH_FP))}
ExecStop=/usr/bin/podman stop app_{APP_NAME}
[Install]
WantedBy=default.target
EOF

# Allow current user to login as service user
tee <<'EOF' > /etc/sudoers.d/app_{shlex.quote(APP_NAME)}
{USER} ALL=(app_{APP_NAME}) NOPASSWD: ALL
EOF
sudo chmod 440 /etc/sudoers.d/app_{shlex.quote(APP_NAME)}
"""


def run_app_user(cmd_part2, check=True, **kwargs):
    """Run shell commands as app user."""

    app_user_id = pwd.getpwnam(f'app_{APP_NAME}').pw_uid
    sudo_preamble = (
        'sudo',
            '-u', f'app_{APP_NAME}',
        'env',
            '--chdir=/tmp',
            f'XDG_RUNTIME_DIR=/run/user/{app_user_id}',
            f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{app_user_id}/bus',
    )

    cmd = (*sudo_preamble, *cmd_part2)
    p = sp.run(cmd, check=check, text=True, **kwargs)

    return p

def con_fmt_sh(con):
    sh_args = [
        shlex.quote(i)
        for i in CON_SERVICES[con]
    ]
    sh_args += [shlex.quote(con)]

    return ' '.join(sh_args)

def to_alpha_num(s):
    return re.sub('[^A-Za-z0-9_-]', '_', s)


# Run setup code that needs to be run as root
if not Path(f'/etc/systemd/user/app_{APP_NAME}.service').exists():
    sp.run(
        ('sudo', 'bash'),
        check=True, text=True, input=SETUP_ROOT_SH_PAYLOAD,
    )
    print("Setup/install code completed. Now re-run this script.")
    sys.exit(0)

# Write container spawning script
script_chmod = 0o755
INIT_CON_SH_FP.touch(script_chmod)
INIT_CON_SH_FP.chmod(script_chmod)
INIT_CON_SH_FP.write_text('#!/usr/bin/env bash\nexec ' + ' '.join(
    shlex.quote(i) for i in (
    *VM_CONTAINER,
    'bash', '-c', f'''
        set -e
        set -x
        mount -t tmpfs -o {HARDENED_TMPFS} tmpfs /tmp

        # Workaround logging issue
        # https://github.com/podman-container-tools/image_build/issues/75
        mkdir /etc/containers/containers.conf.d
        printf '[containers]\\nlog_driver = "k8s-file"\\n' \
            > /etc/containers/containers.conf.d/99-logger-fix.conf

        # Setup pod
        podman pod create app
        podman secret create rh_conf /etc/rathole.toml
        podman secret create origin /pod_secret__origin
        podman secret create db_pw /pod_secret__db_pw

        {';\n'.join((
            f'podman image load -i /docker_imgs/{to_alpha_num(img)}.tar'
            for img in CON_SERVICES.keys()
        ))}

        {';\n'.join((
            'podman create ' + con_fmt_sh(con)
            for con in CON_SERVICES
        ))}

        # Verify rathole image integrity
        if ! test \
            "$(podman inspect -f='{{{{.Id}}}}' rathole:v0.5.0)" \
            = 548fb992c738b11d4e23a95e93f5ccec32a49cc0277adf0d1f4d576744685526
        then
            echo "Bad rathole image!"
            exit 1
        fi

        # Run pod
        podman pod start app
        podman pod logs --names --timestamps --follow app
    ''',
)))

# Create container infrastructure
run_app_user(
    ('podman', 'secret', 'create', '--replace', 'app_rh_conf', '-'),
    input=RH_CONF,
)
run_app_user(
    ('podman', 'secret', 'create', '--replace', 'app_origin', '-'),
    input=NY['origin'],
)
run_app_user(
    ('podman', 'secret', 'create', '--replace', 'app_db_pw', '-'),
    input=NY['db_pw'],
)

# Cache container images
run_app_user(('mkdir', '-p', str(CHILD_IMG_CACHE_DIR)))
for img in CON_SERVICES.keys():
    run_app_user(
        ('podman', 'pull', '--policy=newer', img),
    )
    dst_tar_fp = CHILD_IMG_CACHE_DIR / f'{to_alpha_num(img)}.tar'
    if dst_tar_fp.exists():
        run_app_user(('rm', '--', str(dst_tar_fp.resolve())))
    run_app_user(
        ('podman', 'image', 'save', '-o', str(dst_tar_fp), img),
    )

# Start service
run_app_user((
    'systemctl',
    '--user',
    'enable',
    '--now',
    '--no-pager',
    '--full',
    f'app_{APP_NAME}.service',
))
run_app_user((
    'systemctl',
    '--user',
    'status',
    '--no-pager',
    '--full',
    f'app_{APP_NAME}.service',
))
