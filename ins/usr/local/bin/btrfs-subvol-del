# updated: -


# Run BTRFS subvolume delete command.


import os
import sys
import subprocess as sp
from pathlib import Path


def print2(*args, *kwargs):
    print(*args, **kwargs, file=sys.stderr)


def main():
    if os.getuid() != 0:
        print2("error: Run as/via root/sudo")
        sys.exit(1)

    calling_uid = int(os.getenv('SUDO_UID'))
    for i in sys.argv[1:]:
        fp_uid = Path(i).stat().st_uid
        if calling_uid != fp_uid:
            print2("error: Permission denied:", i)
            sys.exit(1)

    p = sp.run(('btrfs', 'subvolume', 'delete', *sys.argv[1:]))
    sys.exit(p.returncode)

if __name__ == '__main__':
    main()
