#!/usr/bin/env python3
# author: daniel rode
# dependencies: landrun
# created: 12 aug 2026
# updated: 18 aug 2026


"""Run a program in a sandbox.

Run a program so that everything is read-only except the current directory
and its children. If no program is given, run fish shell in private mode.
"""


import sys
import subprocess as sp
from pathlib import Path


LANDRUN_PREAMBLE = (
    'landrun',
    '--add-exec',
    '--rox=/',
    '--rw=/dev/null',
    '--rw=/tmp',
    '--rw', str(Path.cwd()),
    '--env=DCV_CODE_PATH',
    '--env=DCV_HOME_OPT',
    '--env=DFLT_NET_IFACE',
    '--env=EDITOR',
    '--env=GOPATH',
    '--env=HOME',
    '--env=HOSTNAME',
    '--env=LANG',
    '--env=LESS',
    '--env=LESSEDIT',
    '--env=LS_COLORS',
    '--env=PAGER',
    '--env=PATH',
    '--env=R_LIBS_USER',
    '--env=STARSHIP_LOG',
    '--env=TERM',
    '--env=USER',
    '--env=VISUAL',
)


def print2(*args, **kwargs):
    print(*args, **kwargs, file=sys.stderr)


if Path.cwd() == Path.home():
    print2("Current working directory is HOME (will not run!)")
    sys.exit(1)

if len(sys.argv[1:]) == 0:
    child_cmd = ('fish', '--private')
else:
    child_cmd = sys.argv[1:]

cmd = [*LANDRUN_PREAMBLE]
if not child_cmd[0].startswith('-'):
    cmd += ['--']
cmd += child_cmd

print2("RUNNING:", cmd)
try:
    p = sp.run(cmd)
except KeyboardInterrupt:
    sys.exit(1)

sys.exit(p.returncode)



