#!/usr/bin/env bash
# author: daniel rode
# dependencies: podman
# created: 26 feb 2026
# updated: 22 aug 2026


# Serve IPFS (kubo) daemon.


podman run \
    --rm \
    --tty --interactive \
    --network=host \
    --env=IPFS_TELEMETRY=off \
    --env=DO_NOT_TRACK=1 \
    docker.io/ipfs/kubo:latest \
;
