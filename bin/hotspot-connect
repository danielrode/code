# dependencies:
#   ~/code/bin/wconnect
#   ~/.nunyuh
# created: 01 apr 2026
# updated: 09 jul 2026


"""Connect to mobile hotspot."""


import tomllib
import subprocess as sp
from pathlib import Path


HOME = Path.home()
NY = tomllib.loads(Path(HOME, '.nunyuh').read_text())['wconnect']


cmd = (
    str(HOME / 'code/bin/wconnect'),
    'w',
    NY['phone'],
)
sp.run(cmd, check=True)
