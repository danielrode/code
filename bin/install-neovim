#!/usr/bin/env bash
# author: daniel rode
# dependencies: bash 4.3+
# created: 03 sep 2026
# updated: 17 sep 2026


# Install Neovim from source.
#
# https://github.com/neovim/neovim/blob/master/BUILD.md


set -e
set -x


tmpdir="$(mktemp -d)"
function cleanup { rm -fr -- "$tmpdir"; }
trap cleanup EXIT

sudo xbps-install --yes base-devel cmake curl git

# git clone --filter=tree:0 \
git clone --depth=1 \
    https://github.com/neovim/neovim
cd neovim

make CMAKE_BUILD_TYPE=RelWithDebInfo
sudo make install

cd /
