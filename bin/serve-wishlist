#!/usr/bin/env python3
# author: daniel rode
# dependencies: podman, podman-compose, crun-krun, ~/.nunyuh
# created: 04 may 2026
# updated: 27 jul 2026


"""Run cmintey's containerized 'wishlist' app."""


# import sys
import shlex
import getpass
import tomllib
import subprocess as sp
from pathlib import Path

import yaml


APP_NAME = "cmintey_wishlist"

HOME = Path.home()
USER = getpass.getuser()

NY = tomllib.loads((HOME / '.nunyuh').read_text())['S']['wishlist']

CON_HARDENED_DEFAULTS = {
    'runtime': '/usr/bin/krun',
    'cap_drop': ['ALL'],
    'security_opt': ['no-new-privileges'],
    'read_only': True,
    'tmpfs': ['/tmp:rw,noexec,nosuid,nodev,mode=1700'],
    'deploy': {'resources': {'limits': {
        'mem_limit': '128m',  # Limit memory usage
        'cpus': 0.5,  # Limit CPU usage to 50% of a single core
    }}},
}
CON_SERVICES = {
    'wishlist': {
        **CON_HARDENED_DEFAULTS,
        'container_name': 'wishlist',
        'image': 'ghcr.io/cmintey/wishlist:latest',
        'ports': ['3000:3000'],
        'volumes': [
            # Where user image uploads get stored
            'uploads:/usr/src/app/uploads',
            # Where the sqlite database gets stored
            'db:/usr/src/app/data',
        ],
        'environment': {
            'ORIGIN': NY['origin'],
            # TOKEN_TIME: 72 # hours until signup and password reset tokens
            # expire
            'TOKEN_TIME': 72,
        },
        'tmpfs': [':'.join((
            '/usr/src/app/node_modules/.cache/jiti/',
            'rw,noexec,nosuid,nodev,mode=1700'
        ))],
        'restart': 'always',
    },
}
CON_COMPOSE = {
    'version': '3',
    'name': APP_NAME,
    'services': CON_SERVICES,
    'volumes': {
        'db': {},
        'uploads': {},
    }
}

# PODMAN_PREAMBLE = (
#     'sudo', '-u', f'app_{APP_NAME}',
#     'podman-compose',
#     '--no-ansi',
#     '--abort-on-container-failure',
#     '--podman-pull-args=--pull=missing',
#     '--file=-',
# )


# Install and start service
install_payload = f"""
set -e
set -x

# Add user for service
id app_{shlex.quote(APP_NAME)} &>/dev/null || \\
    useradd -m app_{shlex.quote(APP_NAME)}
usermod -a -G app_{shlex.quote(APP_NAME)} {shlex.quote(USER)}
loginctl enable-linger app_{shlex.quote(APP_NAME)}
# systemctl daemon-reload

# Install systemd service file
umask 0022
tee <<'EOF' > /etc/systemd/user/app_{shlex.quote(APP_NAME)}.service
[Unit]
Description=app_{APP_NAME}
Requires=dbus.socket
After=dbus.socket
After=network-online.target
[Service]
Type=forking
Restart=on-failure
RestartSec=33
ExecStart=/usr/bin/podman pod start pod_{APP_NAME}
ExecStop=/usr/bin/podman pod stop pod_{APP_NAME}
[Install]
WantedBy=default.target
EOF

# Firewall rules
# TODO

# Allow current user to login as service user
tee <<'EOF' > /etc/sudoers.d/app_{shlex.quote(APP_NAME)}
{USER} ALL=(app_{APP_NAME}) NOPASSWD: ALL
EOF
sudo chmod 440 /etc/sudoers.d/app_{shlex.quote(APP_NAME)}
"""
sp.run(('sudo', 'bash'), check=True, text=True, input=install_payload)

start_payload = f"""
set -e
set -x

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

# Create container definitions
cd /
podman-compose --file=- up --no-start \\
    <<< {shlex.quote(yaml.dump(CON_COMPOSE))}

# Start service
# systemctl --user \\
#     enable --now --no-pager --full app_{shlex.quote(APP_NAME)}.service
# systemctl --user \\
#     status --no-pager --full app_{shlex.quote(APP_NAME)}.service
systemctl --user --machine=app_{shlex.quote(APP_NAME)}@.host \\
    enable --now --no-pager --full app_{shlex.quote(APP_NAME)}.service
systemctl --user --machine=app_{shlex.quote(APP_NAME)}@.host \\
    status --no-pager --full app_{shlex.quote(APP_NAME)}.service
"""
sp.run(
    ('sudo', '-u', f'app_{APP_NAME}', 'bash'),
    check=True, text=True, input=start_payload,
)

# # Main
# try:
#     p = sp.run(
#         [*PODMAN_PREAMBLE, 'up'],
#         input=yaml.dump(CON_COMPOSE),
#         text=True,
#         check=True,
#     )
#     rc = p.returncode
# except KeyboardInterrupt:
#     rc = 0

# print("Shutting down...")
# sp.run(
#     [*PODMAN_PREAMBLE, 'down'],
#     input=yaml.dump(CON_COMPOSE),
#     text=True,
# )

# sys.exit(rc)
