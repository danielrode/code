#!/usr/bin/env python3
# author: daniel rode
# dependencies:
#   sshfs (local)
#   dtach (on remote host)
# created: 23 feb 2025
# updated: 30 jul 2026


"""Alias/shortcuts for starting SSH sessions."""


import sys
import shlex
import subprocess as sp
from pathlib import Path


HOME = Path.home()
PWD = Path.cwd()
SSH_PREAMBLE = [
    'ssh', '-t',

    # Give up trying to connect if it takes too long
    '-o', 'ConnectionAttempts=64',
    '-o', 'ConnectTimeout=5',

    # Disconnect if server disappears for too long
    '-o', 'ServerAliveCountMax=8',
    '-o', 'ServerAliveInterval=16',
]


# Parse command line arguments
try:
    remote = sys.argv[1]
except IndexError:
    print("error: SSH remote host alias not provided")
    sys.exit(1)

remote_cmd = sys.argv[2:]
if not remote_cmd:
    remote_cmd = ('fish',)

# Set special values for remote host
match remote:
    case 'h'|'p':
        ssh_cmd = ('bash', '--login', '-c', *remote_cmd)
    case _:
        remote_cmd_str = shlex.quote(' '.join(
            shlex.quote(i) for i in ('exec', *remote_cmd)
        ))
        ssh_cmd = (
            # By using dtach, the user can simply close the terminal and it
            # will leave any program in the remote SSH shell running
            # without killing it.
            'bash', '-c', f''':
                tmpdir="$(mktemp -d)"
                # Commenting out for now because Bash would remove socket
                # file before dtach was done with it if terminal closed,
                # making it impossible to connect to the socket later, even
                # though the original dtach instance was still using it.
                # function cleanup {{ rm -fr -- "$tmpdir"; }}
                # trap cleanup EXIT
                [[ -d {shlex.quote(str(PWD))} ]] && cd {shlex.quote(str(PWD))}
                dtach -c "$tmpdir/dtach_$(date '+%Y_%m_%d_%H%M').sock" -zE \\
                    bash -l -c {remote_cmd_str}
                rm -fr -- "$tmpdir"
            ''',
        )

# Connect to remote host via SSH
print("Connecting...")
cmd = (
    'env', 'TERM=xterm',
    *SSH_PREAMBLE,
    remote,
    *ssh_cmd
)
try:
    p = sp.run(cmd)
except KeyboardInterrupt:
    sys.exit(1)

sys.exit(p.returncode)
