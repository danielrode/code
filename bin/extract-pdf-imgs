# updated: -


"""Extract images from a PDF."""


import sys
import subprocess as sp
from pathlib import Path


src_pdf = Path(sys.argv[1])


cmd = (
	'pdfimages', '-print-filenames', '-png', str(src_pdf), src_pdf.stem,
)
sp.run(cmd, check=True)
