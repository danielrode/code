#!/usr/bin/env python3
# author: daniel rode
# dependencies: podman, podman-compose, crun-krun, ~/.nunyuh
# created: 04 may 2026
# updated: 31 jul 2026


"""Install and serve cmintey's containerized 'wishlist' app."""


import pwd
import json
import shlex
import getpass
import tomllib
import subprocess as sp
from pathlib import Path


APP_NAME = "cmintey_wishlist"

HOME = Path.home()
USER = getpass.getuser()

NY = tomllib.loads((HOME / '.nunyuh').read_text())['S']['wishlist']

HARDENED_TMPFS = 'rw,noexec,nosuid,nodev,mode=1700'
CON_IMG_TAG = APP_NAME
CON_HARDENED_DEFAULTS = {
    'runtime': '/usr/bin/krun',
    # 'user': '1111:1111',
    'cap_drop': ['ALL'],
    'security_opt': ['no-new-privileges'],
    'read_only': True,
    'tmpfs': ['/tmp:' + HARDENED_TMPFS],
    'deploy': {'resources': {'limits': {
        'mem_limit': '128m',  # Limit memory usage
        'cpus': 0.5,  # Limit CPU usage to 50% of a single core
    }}},
}
CON_SERVICES = {
    'wishlist': {
        **CON_HARDENED_DEFAULTS,
        'container_name': 'wishlist',
        'image': CON_IMG_TAG,
        'volumes': [
            # Where user image uploads get stored
            'uploads:/usr/src/app/uploads',
            # Where the sqlite database gets stored
            'db:/usr/src/app/data',
        ],
        'environment': {
            'ORIGIN': NY['origin'],
            # TOKEN_TIME: 72 # hours until signup and password reset tokens
            # expire
            'TOKEN_TIME': 72,
        },
        'secrets': [{
            'source': APP_NAME + '_rh_token',
            'target': '/etc/rathole.conf',
            'uid': '0',
            'gid': '0',
            'mode': '0444',
        }],
        'tmpfs': [
            '/usr/src/app/node_modules/.cache/jiti/:' + HARDENED_TMPFS,
            '/usr/src/app/.config/caddy:' + HARDENED_TMPFS,
            '/root/.config/caddy/:' + HARDENED_TMPFS,
        ],
        'restart': 'always',
    },
}
CON_COMPOSE = {
    'version': '3',
    'name': APP_NAME,
    'services': CON_SERVICES,
    'volumes': {
        'db': {},
        'uploads': {},
    },
    'secrets': {
        APP_NAME + '_rh_token': {'external': True},
    },
}

RH_CONF = f"""
[client]
remote_addr = "{NY['remote_addr']}"
[client.services.wishlist]
type = "tcp"
token = "{NY['rh_token']}"
local_addr = "localhost:3000" 
"""

IMG_SHA256 = "a31b9178e985d4a84f46d4c3af6aa200ee0c5e7f821c7075a1f6669fb77392b1"
DOCKERFILE = f"""
FROM ghcr.io/cmintey/wishlist:latest
# Image 52f3a087ccb8 = rathole:v0.5.0
COPY --from=docker.io/rapiz1/rathole@sha256:{IMG_SHA256} \\
    /app/rathole /opt/bin/rathole
COPY <<'EOF' /opt/bin/init.sh
#!/usr/bin/env bash
log_run() {{
    local label="$1"
    shift
    ("$@" 2>&1) | sed -u "s/^/[$label] /"
}}
(
    log_run "RATHOLE" /opt/bin/rathole /etc/rathole.conf &
    log_run "WISHLIST" /usr/bin/sh /usr/src/app/entrypoint.sh &
    wait
) | ts '[%Y-%m-%d %H:%M:%S]'
EOF
RUN apt-get update \\
    && apt-get install -y --no-install-recommends \\
        bash moreutils \\
    && rm -rf /var/lib/apt/lists/* \\
    && apt-get clean \\
;

ENTRYPOINT bash /opt/bin/init.sh
"""

SETUP_ROOT_SH_PAYLOAD = f"""
set -e
set -x

# Add user for service
id app_{shlex.quote(APP_NAME)} &>/dev/null || \\
    useradd -m app_{shlex.quote(APP_NAME)}
usermod -a -G app_{shlex.quote(APP_NAME)} {shlex.quote(USER)}
loginctl enable-linger app_{shlex.quote(APP_NAME)}
# systemctl daemon-reload

# Install systemd service file
umask 0022
tee <<'EOF' > /etc/systemd/user/app_{shlex.quote(APP_NAME)}.service
[Unit]
Description=app_{APP_NAME}
Requires=dbus.socket
After=dbus.socket
After=network-online.target
[Service]
Type=forking
Restart=on-failure
RestartSec=33
ExecStart=/usr/bin/podman pod start pod_{APP_NAME}
ExecStop=/usr/bin/podman pod stop pod_{APP_NAME}
[Install]
WantedBy=default.target
EOF

# Allow current user to login as service user
tee <<'EOF' > /etc/sudoers.d/app_{shlex.quote(APP_NAME)}
{USER} ALL=(app_{APP_NAME}) NOPASSWD: ALL
EOF
sudo chmod 440 /etc/sudoers.d/app_{shlex.quote(APP_NAME)}
"""


# Run setup code that needs to be run as root
try:
    app_user_id = pwd.getpwnam(f'app_{APP_NAME}').pw_uid
except KeyError:
    app_user_id = None

if any((
    app_user_id is None,
    not Path(f'/etc/systemd/user/app_{APP_NAME}.service').exists(),
)):
    sp.run(
        ('sudo', 'bash'),
        check=True, text=True, input=SETUP_ROOT_SH_PAYLOAD,
    )

# Build container
app_user_id = pwd.getpwnam(f'app_{APP_NAME}').pw_uid
cmd_preamble = (
    'sudo',
        '-u', f'app_{APP_NAME}',
    'env',
        '--chdir=/tmp',
        f'XDG_RUNTIME_DIR=/run/user/{app_user_id}',
        f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{app_user_id}/bus',
)
sp.run(
    (
        *cmd_preamble,
        'podman', 'build',
            '--file=-',
            '--tag', CON_IMG_TAG,
    ),
    input=DOCKERFILE,
    check=True, text=True,
)

# Create container
sp.run(
    (
        *cmd_preamble,
        'podman', 'secret', 'create', '--replace', f'{APP_NAME}_rh_token', '-',
    ),
    input=RH_CONF,
    check=True, text=True,
)
sp.run(
    (
        *cmd_preamble,
        'podman-compose', '--file=-', 'up', '--no-start',
    ),
    input=json.dumps(CON_COMPOSE),
    check=True, text=True,
)

# Start container
sp.run(
    (
        *cmd_preamble,
        'systemctl',
        '--user',
        f'--machine=app_{APP_NAME}@.host',
        'enable',
        '--now',
        '--no-pager',
        '--full',
        f'app_{APP_NAME}.service',
    ),
    check=True,
)
sp.run(
    (
        *cmd_preamble,
        'systemctl',
        '--user',
        f'--machine=app_{APP_NAME}@.host',
        'status',
        '--no-pager',
        '--full',
        f'app_{APP_NAME}.service',
    ),
    check=True,
)
