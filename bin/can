# updated: 27 sep 2026


"""Trash files.

(Trash)Can. Sends a given set of files to the trash. Accounts for various
platforms and available tools.
"""


import os
import sys
import uuid
import fcntl
import shutil
import subprocess as sp
from pathlib import Path
from datetime import datetime
from tempfile import TemporaryDirectory
from tempfile import NamedTemporaryFile


EXE_NAME = Path(__file__).name
HELP = f"Usage: {EXE_NAME} PATH..."
HOME = Path.home()
PWD = Path.cwd()

TRASH_DIR = HOME / '.trash'


class ContextManagerPass:
    """Empty 'do nothing' context manager class."""
    def __init__(*a, **kw):
        pass

    def __enter__(*a, **kw):
        pass

    def __exit__(*a, **kw):
        pass


def print2(*a, **kw):
    print(*a, **kw, file=sys.stderr)

def same_filesystem(a, b):
    """Check if two paths are on the same filesystem."""

    if os.stat(a).st_dev == os.stat(b).st_dev:
        return True
    else:
        return False

def reflink_supported(a, b):
    """Check if making a reflink copy between a and dir b is supported."""

    a = Path(a)
    b = Path(b)

    if a.is_dir():
        src_tf = NamedTemporaryFile('w', prefix='.tmp_', dir=a)
        a = src_tf.name
    else:
        src_tf = ContextManagerPass()

    with (
        src_tf,
        TemporaryDirectory(prefix='.tmp_', dir=b) as dst_td,
    ):
        try:
            cp_reflink_a(a, Path(dst_td, 'test'))
        except OSError as e:
            if str(e) in (
                '[Errno 18] Invalid cross-device link',
                '[Errno 95] Operation not supported',
            ):
                return False
            else:
                raise e

    return True

def cp_reflink_a(src, dst):
    """Copy file as reflink and preserve metadata."""

    with open(src, "rb") as s, open(dst, "wb") as d:
        fcntl.ioctl(d.fileno(), fcntl.FICLONE, s.fileno())

    shutil.copystat(src, dst)

def cp_r(src, dst):
    """Copy file or directory."""

    if src.is_dir():
        shutil.copytree(
            src,
            dst,
            symlinks=True,
            ignore_dangling_symlinks=True,
            copy_function=cp_reflink_a,
        )
    else:
        cp_reflink_a(src, dst)

def rm_r(fp):
    """Delete file or directory."""

    if fp.is_dir():
        shutil.rmtree(fp)
    else:
        fp.unlink()

def setup_trash_entry(fp, trash_dir):
    """Create formatted directory entry under trash_dir for fp."""

    dst_fp = Path(
        trash_dir,
        "__".join((
            datetime.now().strftime("%Y-%m-%d-%H%M%S"),
            str(uuid.uuid4()),
            fp.name,
        )),
        'file',
    )
    dst_fp.parent.mkdir(exist_ok=True, parents=True)

    info_fp = dst_fp.parent / 'src'
    info_fp.write_text(str(fp.resolve()))

    return dst_fp

def trash(fp):
    """Trash a given file/dir."""

    if same_filesystem(fp, TRASH_DIR):
        dst_fp = setup_trash_entry(fp, TRASH_DIR)
        fp.rename(dst_fp)
    elif reflink_supported(fp, TRASH_DIR):
        dst_fp = setup_trash_entry(fp, TRASH_DIR)
        cp_r(fp, dst_fp)
        rm_r(fp)
    else:
        dst_fp = setup_trash_entry(fp, fp.parent/'.trash')
        fp.rename(dst_fp)


if __name__ == '__main__':
    # Parse command line arguments
    if not sys.argv[1:]:
        print2(HELP)
        sys.exit(1)

    # Process files
    for fp in sys.argv[1:]:
        fp = Path(fp)

        if not fp.exists():
            print("SKIPPING (path does not exist):", fp)
            continue

        if fp.is_mount():
            sp.run(['umount', '--verbose', str(fp)], check=True)

        print("Trashing:", fp)
        trash(fp)
